      ],
      "disabled": false
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "apifyToken",
              "stringValue": "YOUR_APIFY_TOKEN"
            },
            {
              "name": "keywords",
              "stringValue": "Accountant, SAP FICO, Finance Analyst, Audit, Taxation"
